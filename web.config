<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Go ten mien la mo index.php -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <!-- An cac thu muc khong duoc truy cap tu trinh duyet -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="inc" />
          <add segment="storage" />
          <add segment="database" />
          <add segment="deploy" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="X-UA-Compatible" value="IE=edge" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
